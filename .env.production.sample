# 入口網站（Cloudflare Worker）的網域，例如 pjqaqc.<subdomain>.workers.dev。
# 必須與瀏覽器網址列的網域完全相同，否則編輯者的寫入會回 403。
PUBLIC_HOSTNAME=pjqaqc.example.workers.dev
SUPABASE_URL=https://tptjijcynzwskfcgkvmx.supabase.co
# 從 Supabase 專案的 Settings → API Keys 複製 Publishable key。
SUPABASE_PUBLISHABLE_KEY=
# 指定要部署的映像版本；預設為 latest。建議填 GitHub Actions 顯示的 commit SHA，方便回復。
# API_IMAGE=ghcr.io/henry4234/pjqaqc-api:<commit-sha>
