# 複製此檔為 .env 並填入實際值（.env 不會被提交到 Git）
# cp .env.sample .env

# MySQL 資料庫連線
MYSQL_HOST=192.168.0.111
MYSQL_PORT=3306
MYSQL_USER=your_mysql_user
MYSQL_PASSWORD=your_mysql_password
MYSQL_DATABASE=PJQAQC

# AI 品管判讀（至少填一把才能使用；每位協作者請用自己的金鑰，說明見 README）
# Anthropic Claude API 金鑰，格式 sk-ant-...
ANTHROPIC_API_KEY=
# OpenAI API 金鑰，格式 sk-...
OPENAI_API_KEY=

# 可選：覆寫判讀模型
AI_MODEL=claude-opus-5-5
OPENAI_MODEL=gpt-6.1-sol
